# ═══════════════════════════════════════════════════════════════
# Variables de entorno para docker-compose (raíz del proyecto)
#
#   1. Copiá este archivo a .env  →  cp .env.example .env
#   2. Completá los valores (sobre todo los secretos).
#   3. NUNCA comitees el .env (está en .gitignore).
#
# Generá secretos fuertes (>= 32 bytes) con:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════

# ─── Postgres ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_password_fuerte
POSTGRES_DB=concesionaria

# ─── Puerto del host del frontend ───────────────────────────────
# nginx del frontend es el único puerto publicado. Local: 80 (localhost).
# En la Raspberry Pi: 8082 (cloudflared rutea autenza.nebulant.com.ar -> localhost:8082).
FRONTEND_HOST_PORT=80

# ─── Backend ────────────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=generar_con_openssl_rand_hex_32
JWT_REFRESH_SECRET=generar_otro_distinto_con_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info

# ─── Frontend (build-time) ──────────────────────────────────────
# URL del backend horneada en el bundle del front. Default "/api" (relativa):
# el nginx del frontend proxya /api -> backend (mismo origen, sin CORS).
# Dejalo así salvo que separes el front y el back en dominios distintos.
# VITE_API_BASE_URL=/api
